<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Vibra - Professional social platform for sharing moments and connecting with others">
  <meta name="keywords" content="social media, photos, sharing, community, vibra">
  <meta name="author" content="Vibra Team">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="Discover, share, and connect with the world through beautiful moments and stories">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Vibra">
  
  <title><%= title %></title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📱</text></svg>">
  
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <%- body %>
  </main>

  <%- include('partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Navbar scroll effect
      const navbar = document.getElementById('navbar');
      let lastScrollTop = 0;
      
      window.addEventListener('scroll', function() {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        
        if (scrollTop > 50) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }
        
        // Hide navbar on scroll down, show on scroll up
        if (scrollTop > lastScrollTop && scrollTop > 100) {
          navbar.style.transform = 'translateY(-100%)';
        } else {
          navbar.style.transform = 'translateY(0)';
        }
        
        lastScrollTop = scrollTop;
      });

      // Add smooth scrolling to all anchor links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });

      // Post interaction handlers
      document.querySelectorAll('.post-action').forEach(action => {
        action.addEventListener('click', function(e) {
          e.stopPropagation();
          
          if (this.textContent.trim() === '❤️') {
            this.classList.toggle('liked');
            
            // Update like count
            const likesElement = this.closest('.post').querySelector('.post-likes');
            const currentLikes = parseInt(likesElement.textContent.match(/\d+/)[0]);
            const newLikes = this.classList.contains('liked') ? currentLikes + 1 : currentLikes - 1;
            likesElement.textContent = `${newLikes} likes`;
            
            // Add heart animation
            if (this.classList.contains('liked')) {
              this.style.animation = 'heartBeat 0.6s ease-in-out';
              setTimeout(() => {
                this.style.animation = '';
              }, 600);
            }
          }
          
          if (this.textContent.trim() === '💬') {
            alert('Comments feature coming soon!');
          }
          
          if (this.textContent.trim() === '📤') {
            alert('Share feature coming soon!');
          }
          
          if (this.textContent.trim() === '🔖') {
            this.style.color = this.style.color === 'var(--accent-blue)' ? '' : 'var(--accent-blue)';
            alert(this.style.color ? 'Post saved!' : 'Post unsaved!');
          }
        });
      });

      // Search functionality
      const searchInput = document.querySelector('.search-input');
      if (searchInput) {
        searchInput.addEventListener('input', function(e) {
          const query = e.target.value.toLowerCase();
          
          if (query.length > 2) {
            // Simulate search results
            console.log('Searching for:', query);
            
            // Highlight matching posts
            document.querySelectorAll('.post').forEach(post => {
              const username = post.querySelector('.post-username').textContent.toLowerCase();
              const caption = post.querySelector('.post-caption').textContent.toLowerCase();
              
              if (username.includes(query) || caption.includes(query)) {
                post.style.border = '2px solid var(--accent-blue)';
                post.style.boxShadow = '0 0 20px rgba(0, 149, 246, 0.3)';
              } else {
                post.style.border = '';
                post.style.boxShadow = '';
              }
            });
          } else {
            // Clear highlights
            document.querySelectorAll('.post').forEach(post => {
              post.style.border = '';
              post.style.boxShadow = '';
            });
          }
        });
        
        // Clear search on escape
        searchInput.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            this.value = '';
            document.querySelectorAll('.post').forEach(post => {
              post.style.border = '';
              post.style.boxShadow = '';
            });
          }
        });
      }

      // Load More Posts functionality
      const loadMoreBtn = document.getElementById('loadMoreBtn');
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
          const btnText = this.querySelector('.btn-text');
          const btnLoader = this.querySelector('.btn-loader');
          
          // Show loading state
          btnText.style.display = 'none';
          btnLoader.style.display = 'inline-block';
          this.classList.add('loading');
          
          // Simulate loading new posts
          setTimeout(() => {
            // Reset button state
            btnText.style.display = 'inline-block';
            btnLoader.style.display = 'none';
            this.classList.remove('loading');
            
            // Show success message
            alert('🎉 New posts loaded! Scroll up to see more amazing content.');
            
            // Scroll to top of feed smoothly
            document.getElementById('feed').scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }, 2000);
        });
      }

      // Add loading states to forms
      document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', function(e) {
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) {
            const originalText = submitBtn.textContent;
            submitBtn.textContent = 'Sending...';
            submitBtn.disabled = true;
            
            // Simulate form submission
            setTimeout(() => {
              submitBtn.textContent = originalText;
              submitBtn.disabled = false;
              alert('Message sent successfully!');
            }, 2000);
          }
        });
      });

      // Intersection Observer for animations
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
          }
        });
      }, observerOptions);

      // Observe all posts for scroll animations
      document.querySelectorAll('.post').forEach((post, index) => {
        post.style.opacity = '0';
        post.style.transform = 'translateY(30px)';
        post.style.transition = `opacity 0.6s ease ${index * 0.1}s, transform 0.6s ease ${index * 0.1}s`;
        observer.observe(post);
      });

      // Add parallax effect to floating elements
      window.addEventListener('scroll', function() {
        const scrolled = window.pageYOffset;
        const parallax = document.querySelectorAll('.floating-element');
        
        parallax.forEach((element, index) => {
          const speed = 0.5 + (index * 0.1);
          element.style.transform = `translateY(${scrolled * speed}px) rotate(${scrolled * 0.1}deg)`;
        });
      });

      // Add staggered loading animation to posts
      document.querySelectorAll('.post').forEach((post, index) => {
        post.style.animationDelay = `${index * 0.1}s`;
      });
      
      // Add infinite scroll hint
      let scrollHintShown = false;
      window.addEventListener('scroll', () => {
        const scrollPercent = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
        
        if (scrollPercent > 70 && !scrollHintShown) {
          scrollHintShown = true;
          const loadMoreBtn = document.getElementById('loadMoreBtn');
          if (loadMoreBtn) {
            loadMoreBtn.style.animation = 'pulse 1s ease-in-out 3';
          }
        }
      });
    });
  </script>
</body>
</html>
