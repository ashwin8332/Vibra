<section class="hero">
  <div class="container">
    <div class="card">
      <div class="card-content">
        <h1>Get in Touch</h1>
        <p>We'd love to hear from you! Whether you have questions, feedback, or just want to say hello, don't hesitate to reach out.</p>
      </div>
    </div>  
    <div class="contact-form">
      <h2 style="margin-bottom: 24px; color: var(--text-primary);">Send us a Message</h2>
      <form action="#" method="POST">
        <div class="form-group">
          <label for="name" class="form-label">Full Name</label>
          <input type="text" id="name" name="name" class="form-input" placeholder="Enter your full name" required>
        </div>        
        <div class="form-group">
          <label for="email" class="form-label">Email Address</label>
          <input type="email" id="email" name="email" class="form-input" placeholder="your@email.com" required>
        </div>        
        <div class="form-group">
          <label for="subject" class="form-label">Subject</label>
          <input type="text" id="subject" name="subject" class="form-input" placeholder="What's this about?" required>
        </div>        
        <div class="form-group">
          <label for="message" class="form-label">Message</label>
          <textarea id="message" name="message" class="form-textarea" placeholder="Tell us more about your inquiry..." required></textarea>
        </div>        
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <button type="submit" class="btn btn-primary">Send Message</button>
          <button type="reset" class="btn btn-secondary">Clear Form</button>
        </div>
      </form>
    </div>
    <div class="card">
      <div class="card-header">
        <h2>Other Ways to Connect</h2>
      </div>
      <div class="card-content">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
          <div>
            <h3 style="margin-bottom: 8px; color: var(--text-primary);">📧 Email Support</h3>
            <p style="margin-bottom: 4px;"><a href="mailto:support@vibra.app">support@vibra.app</a></p>
            <small style="color: var(--text-muted);">We typically respond within 24 hours</small>
          </div>
          <div>
            <h3 style="margin-bottom: 8px; color: var(--text-primary);">💬 Community</h3>
            <p style="margin-bottom: 4px;"><a href="#">Join our Discord</a></p>
            <small style="color: var(--text-muted);">Connect with other Vibra users</small>
          </div>          
          <div>
            <h3 style="margin-bottom: 8px; color: var(--text-primary);">🐛 Report Issues</h3>
            <p style="margin-bottom: 4px;"><a href="#">GitHub Repository</a></p>
            <small style="color: var(--text-muted);">Found a bug? Let us know!</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>